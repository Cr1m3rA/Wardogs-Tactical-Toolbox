{
  "name": "wardogs-artillery-toolbox",
  "version": "1.1.0",
  "description": "WARDOGS 战术工具箱桌面版：迫击炮诸元 / 测距标绘 / 建造规划，支持游戏内悬浮窗（不接触游戏内存，反作弊安全）",
  "main": "main.js",
  "license": "Apache-2.0",
  "author": "Cr1m3rA",
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "electron .",
    "dist": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.2.1",
    "@floating-ui/dom": "^1.8.0",
    "@lit/react": "^1.0.8",
    "@shoelace-style/animations": "^1.2.0",
    "@shoelace-style/localize": "^3.2.3",
    "@shoelace-style/shoelace": "^2.20.1",
    "composed-offset-position": "^0.0.6",
    "lit": "^3.3.3"
  },
  "build": {
    "appId": "com.cr1m3ra.wardogs.artillery-toolbox",
    "productName": "WARDOGS 战术工具箱",
    "files": [
      "main.js",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
